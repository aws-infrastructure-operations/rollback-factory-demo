{
  "name": "deploy-aws-cloudfront",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "app": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc -p app",
    "test": "tsx --test test/*.test.ts",
    "cdk": "cdk",
    "synth:dev": "cdk synth -c env=dev",
    "synth:prod": "cdk synth -c env=prod",
    "app:dev": "vite app",
    "app:build": "vite build app",
    "app:preview": "vite preview app",
    "deploy:dev": "tsx scripts/deploy.ts --env dev",
    "deploy:prod": "tsx scripts/deploy.ts --env prod",
    "release:build": "tsx scripts/build-release.ts",
    "release:upload": "tsx scripts/upload-release.ts",
    "release:activate": "tsx scripts/activate-release.ts",
    "live:context": "tsx scripts/live-context.ts",
    "deployment:record": "tsx scripts/record-deployment.ts",
    "deployment:verify": "tsx scripts/verify-deployment.ts",
    "deployment:list": "tsx scripts/list-deployments.ts",
    "deployment:restore": "tsx scripts/restore-deployment.ts",
    "test:integration": "tsx --test --test-concurrency=1 integration/*.test.ts",
    "rollback:trigger": "tsx scripts/trigger-rollback.ts",
    "demo:traffic": "tsx scripts/generate-traffic.ts"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.1146.0",
    "@aws-sdk/client-apigatewayv2": "^3.1146.0",
    "@aws-sdk/client-cloudwatch": "^3.1146.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1146.0",
    "@aws-sdk/client-cloudfront": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sts": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk": "^2.1144.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
