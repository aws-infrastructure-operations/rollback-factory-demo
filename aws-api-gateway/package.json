{
  "name": "aws-api-gateway",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "app": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "cdk": "cdk",
    "synth:dev": "cdk synth -c env=dev",
    "deploy:dev": "tsx scripts/sync-collection.ts --env dev && cdk deploy -c env=dev --require-approval never && tsx scripts/record-deployment.ts --env dev",
    "deploy:prod": "tsx scripts/sync-collection.ts --env prod && cdk deploy -c env=prod --require-approval never && tsx scripts/record-deployment.ts --env prod",
    "collection:sync": "tsx scripts/sync-collection.ts",
    "token": "tsx scripts/get-token.ts",
    "user:create": "tsx scripts/create-user.ts",
    "deployment:record": "tsx scripts/record-deployment.ts",
    "deployment:list": "tsx scripts/list-deployments.ts",
    "test:integration": "tsx --test --test-concurrency=1 integration/*.test.ts",
    "rollback:trigger": "tsx scripts/trigger-rollback.ts",
    "demo:traffic": "tsx scripts/generate-traffic.ts",
    "deployment:verify": "tsx scripts/verify-deployment.ts",
    "deployment:restore": "tsx scripts/restore-deployment.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-api-gateway": "^3.1146.0",
    "@aws-sdk/client-cloudformation": "^3.1146.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sts": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "aws-cdk": "^2.1144.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
