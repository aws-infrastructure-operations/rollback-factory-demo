{
  "name": "aws-api-gateway",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "app": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "cdk": "cdk",
    "synth:dev": "cdk synth -c env=dev",
    "deploy:dev": "cdk deploy -c env=dev --require-approval never",
    "deploy:prod": "cdk deploy -c env=prod --require-approval never"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "aws-cdk": "^2.1144.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
