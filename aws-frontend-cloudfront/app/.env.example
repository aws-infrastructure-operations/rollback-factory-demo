# Copy to app/.env.local for `npm run app:dev`. Values come from the api-user stack outputs
# (aws cloudformation describe-stacks --stack-name rollback-factory-demo-dev).
VITE_API_URL=https://<api-id>.execute-api.eu-central-1.amazonaws.com/v1/
VITE_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REGION=eu-central-1
# Shown in the footer; the release build sets it.
VITE_RELEASE_ID=local
